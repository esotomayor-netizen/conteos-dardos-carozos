DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# API key de Google Maps (Geocoding API + Maps JavaScript API habilitadas).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY se expone al navegador para pintar el mapa.
# GOOGLE_MAPS_API_KEY la usa scripts/geocode-productores.mjs (puede ser la misma key).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY=
